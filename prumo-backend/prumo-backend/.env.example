# Copie para .env e carregue com:  node --env-file=.env src/server.js
NODE_ENV=development
PORT=3000
DB_PATH=./data/prumo.db

# OBRIGATÓRIOS em produção (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
DOC_HMAC_KEY=
DOC_ENC_KEY=
PAYMENT_WEBHOOK_SECRET=

# Front em outro domínio? Informe a origem e use SameSite=None (exige HTTPS)
CORS_ORIGIN=
COOKIE_SAMESITE=Strict
TRUST_PROXY=0

# IA (sem chave, a API responde com regras simples de exemplo)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Ferramentas de desenvolvimento (pagamento simulado, gov.br simulado). Desligadas em produção por padrão.
DEV_TOOLS=
